<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Book a Service</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <% errors.forEach(function(error) { %>
          <p class="mb-0"><%= error %></p>
        <% }); %>
      </div>
    <% } %>

    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success">
        <% messages.forEach(function(message) { %>
          <p class="mb-0"><%= message %></p>
        <% }); %>
      </div>
    <% } %>

    <% if (!pets || pets.length === 0) { %>
      <div class="alert alert-info">
        You do not have any pets yet. <a href="/pets/new" class="alert-link">Add a pet first</a> before booking a service.
      </div>
    <% } %>

    <% if (!services || services.length === 0) { %>
      <div class="alert alert-info">
        No services are currently available.
      </div>
    <% } %>

    <% if (pets && pets.length > 0 && services && services.length > 0) { %>
      <form action="/services/book" method="POST">
        <div class="card mb-4">
          <div class="card-body">
            <div class="mb-3">
              <label for="petId" class="form-label">Choose a pet</label>
              <select name="petId" id="petId" class="form-select" required>
                <option value="">-- Select a pet --</option>
                <% for (let i = 0; i < pets.length; i++) { %>
                  <% const pet = pets[i]; %>
                  <option value="<%= pet.id %>" <%= String(selectedPetId) === String(pet.id) ? 'selected' : '' %>><%= pet.name %> (<%= pet.species %>)</option>
                <% } %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label">Choose a service</label>
              <div class="list-group">
                <% for (let i = 0; i < services.length; i++) { %>
                  <% const service = services[i]; %>
                  <label class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                      <input type="radio" name="serviceId" value="<%= service.id %>" required>
                      <span class="ms-2"><%= service.name %></span>
                    </span>
                    <span class="badge bg-primary rounded-pill">S$<%= Number(service.price).toFixed(2) %></span>
                  </label>
                <% } %>
              </div>
            </div>

            <div class="mb-3">
              <label for="bookingDate" class="form-label">Booking date</label>
              <input
                type="date"
                name="bookingDate"
                id="bookingDate"
                class="form-control"
                min="<%= today %>"
                required>
            </div>

            <button type="submit" class="btn btn-primary">Create Booking</button>
          </div>
        </div>
      </form>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
